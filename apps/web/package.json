{
  "name": "rakrao-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.18.4"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.36.0",
    "jsdom": "27.0.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
